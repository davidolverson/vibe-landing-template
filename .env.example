# Resend API key for waitlist signup notifications (optional).
# Without it, signups are still stored in the local SQLite database.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives a notification email for each waitlist signup.
# On Resend's free tier this must be your Resend account email until you verify a domain.
RESEND_NOTIFY_EMAIL=owner@example.com

# Password for the /admin leads dashboard. Use a long random value in production.
ADMIN_PASSWORD=change_me_in_production

# Set automatically on Vercel; when present the SQLite DB is written to /tmp (ephemeral).
# VERCEL=1
